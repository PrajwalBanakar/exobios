# ── Exobios AI — Environment Variables ────────────────────────────────────────
# Copy this file to .env and fill in real values before running.
# Never commit .env to version control.

APP_NAME=exobios-ai
APP_ENV=development
APP_VERSION=0.1.0
HOST=0.0.0.0
PORT=8000

# Must match the backend's AI_API_KEY (app.ai.api-key) exactly.
AI_API_KEY=replace-with-a-secure-development-key

LOG_LEVEL=INFO

# Disable in production deployments.
ENABLE_API_DOCS=true

# ── Embeddings (AI-3) ──────────────────────────────────────────────────────
OPENAI_API_KEY=replace-with-a-real-openai-api-key
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_BATCH_SIZE=100

# Defaults match docker-compose.yml's local Qdrant service.
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=exobios_chunks

# ── Retrieval (AI-4) ───────────────────────────────────────────────────────
RETRIEVAL_TOP_K=20
MIN_SIMILARITY_SCORE=0.0
MAX_RETURNED_CHUNKS=10

# ── Prompting (AI-5) ───────────────────────────────────────────────────────
MAX_PROMPT_TOKENS=4000
MAX_CONTEXT_TOKENS=2000
RESERVED_RESPONSE_TOKENS=500
DEFAULT_PROMPT_TEMPLATE=diagnosis

# ── Generation (AI-6) ──────────────────────────────────────────────────────
# Reuses OPENAI_API_KEY above — no separate LLM API key.
LLM_MODEL=gpt-4.1-mini
LLM_TEMPERATURE=0.2
LLM_MAX_OUTPUT_TOKENS=1500
LLM_TIMEOUT_SECONDS=30.0
LLM_MAX_RETRIES=2
# Optional: leave unset to skip the prompt-budget pre-flight check.
LLM_CONTEXT_WINDOW=

# ── Document storage + registry (AI-7A) ───────────────────────────────────
# Relative paths resolve against the exobios-ai project root, not the
# current working directory. Original client PDFs live under
# DOCUMENT_STORAGE_ROOT (see data/README.md) and are never committed.
DOCUMENT_STORAGE_ROOT=./data/source_documents
DOCUMENT_REGISTRY_DB_PATH=./data/document_registry.db
DOCUMENT_EXTRACTED_ROOT=./data/extracted
DOCUMENT_PROCESSED_ROOT=./data/processed

# ── Textbook chunking (AI-7B) ──────────────────────────────────────────────
# Token counts use the same ~4-chars-per-token heuristic already used by
# app/prompting (count_tokens) — provider-agnostic, no tokenizer download.
TEXTBOOK_CHUNK_TARGET_TOKENS=650
TEXTBOOK_CHUNK_MAX_TOKENS=800
TEXTBOOK_CHUNK_OVERLAP_TOKENS=100
TEXTBOOK_MIN_CHUNK_TOKENS=20

# ── Textbook RAG (AI-7C) ───────────────────────────────────────────────────
# Separate from QDRANT_COLLECTION (the existing IMNCI demo's collection) —
# keeps the two pipelines isolated.
QDRANT_TEXTBOOK_COLLECTION=exobios_knowledge
# STRICT is the only implemented mode this phase.
KNOWLEDGE_GROUNDING_MODE=STRICT
# Minimum cosine similarity a top retrieved chunk must clear before the LLM
# is even called — below this, the system returns INSUFFICIENT_EVIDENCE
# without spending a generation call. See the AI-7C report for how this was
# chosen from real score distributions.
TEXTBOOK_MIN_RETRIEVAL_SCORE=0.5
