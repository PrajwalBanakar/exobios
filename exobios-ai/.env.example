# ── Exobios AI — Environment Variables ────────────────────────────────────────
# Copy this file to .env and fill in real values before running.
# Never commit .env to version control.

APP_NAME=exobios-ai
APP_ENV=development
APP_VERSION=0.1.0
HOST=0.0.0.0
PORT=8000

# Must match the backend's AI_API_KEY (app.ai.api-key) exactly.
AI_API_KEY=replace-with-a-secure-development-key

LOG_LEVEL=INFO

# Disable in production deployments.
ENABLE_API_DOCS=true
