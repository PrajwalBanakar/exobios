# ── Environment ───────────────────────────────────────────────────────────────
.env
.env.local
.env.*.local

# ── Python ────────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.egg-info/
dist/
build/

# ── Virtual environments ──────────────────────────────────────────────────────
.venv/
venv/

# ── Test / lint caches ────────────────────────────────────────────────────────
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/

# ── IDE ───────────────────────────────────────────────────────────────────────
.vscode/
.idea/

# ── Local document storage (real PDFs / derived artifacts, never committed) ────
data/source_documents/**
!data/source_documents/**/.gitkeep
data/extracted/**
!data/extracted/.gitkeep
data/processed/**
!data/processed/.gitkeep
data/document_registry.db
*.db

# ── Ingestion project (its own local artifacts) ─────────────────────────────────
ingestion/documents/*.pdf
ingestion/ingestion.log

# ── uv ───────────────────────────────────────────────────────────────────────
app/.venv/
ingestion/.venv/
