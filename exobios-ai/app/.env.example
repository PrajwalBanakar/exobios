# Exobios AI service (app/) — copy to app/.env and fill in real values.
# This file is read relative to app/ (the process must be started with app/
# as its working directory — see docs/LOCAL_SETUP.md).

# ── Service auth ───────────────────────────────────────────────────────────
# Shared secret the caller (Postman locally, Spring Boot later) must send as
# the X-Api-Key header. Any non-empty value works for local development.
AI_API_KEY=

# ── Qdrant (vector store) ───────────────────────────────────────────────────
# Local dev: `docker compose up -d qdrant` from the exobios-ai/ root.
QDRANT__URL=http://localhost:6333
QDRANT__COLLECTION_NAME=corpus

# ── Embeddings (Hugging Face hosted inference) ──────────────────────────────
# Required. Free HF account + access token (read scope) is enough — the
# default model below is public/ungated, no special model access needed.
EMBEDDING__HF_TOKEN=
EMBEDDING__EMBED_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING__EMBED_URL=https://router.huggingface.co/hf-inference/models/sentence-transformers/all-MiniLM-L6-v2/pipeline/feature-extraction
EMBEDDING__VECTOR_SIZE=384

# ── Reranker (Hugging Face hosted inference) ────────────────────────────────
# Required (token). Can reuse the same HF token as EMBEDDING__HF_TOKEN above.
RERANKER__HF_TOKEN=
RERANKER__RERANK_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
RERANKER__RERANK_URL=https://router.huggingface.co/hf-inference/models/cross-encoder/ms-marco-MiniLM-L-6-v2
# As of the 2026-08 audit, HF's hosted-inference router has NO active
# provider for any text-ranking/cross-encoder model (verified live — see
# docs/ARCHITECTURE.md's Reranker section for the exact 400 response and the
# options considered). Disabled here so every retrieval call doesn't pay for
# a guaranteed-failing HTTP round trip; retrieval still works correctly via
# the hybrid dense+sparse fusion order alone. Set to true once
# RERANKER__RERANK_MODEL/RERANKER__RERANK_URL point at something real.
RERANKER__ENABLED=false

# ── LLM (Groq) ───────────────────────────────────────────────────────────────
# Required. Free tier available at https://console.groq.com.
LLM__GROQ_API_KEY=
LLM__MODEL=llama-3.3-70b-versatile
LLM__MAX_OUTPUT_TOKENS=2048
LLM__TEMPERATURE=0.2

# ── MongoDB (assessment persistence) ────────────────────────────────────────
# Local dev: `docker compose up -d mongo` from the exobios-ai/ root.
MONGO__URI=mongodb://localhost:27017
MONGO__DB_NAME=exobios
MONGO__ASSESSMENTS_COLLECTION=assessments

# ── Rate limiting (in-process — see core/rate_limit.py for the production
#    limitation of per-process enforcement once this runs as >1 instance) ────
RATE_LIMIT__ENABLED=true
RATE_LIMIT__REQUESTS=60
RATE_LIMIT__WINDOW_SECONDS=60

# ── LangSmith (optional tracing) ────────────────────────────────────────────
# Leave blank to disable tracing entirely (default/recommended for local
# dev). Only set this if you have your own LangSmith project — never share
# or hardcode a real key here.
LANGSMITH__API_KEY=
LANGSMITH__PROJECT=exobios-ai
