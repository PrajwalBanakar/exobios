# Exobios AI ingestion pipeline (ingestion/) — copy to ingestion/.env.
# Standalone offline CLI tool: converts PDFs -> docling -> chunks -> embeddings
# -> Qdrant. Not called at runtime by app/; the two projects only share the
# Qdrant collection as a data contract. Run from ingestion/ as cwd.

# ── Hugging Face (zero-shot document classification) ───────────────────────
# Required. Same token as app/'s EMBEDDING__HF_TOKEN works.
ZEROSHOT_CLASSIFICATION_TOKEN_HF=

# ── Supabase (document metadata storage) ────────────────────────────────────
# Required — save_document_metadata() writes here unconditionally.
SUPABASE_URL=
SUPABASE_KEY=

# ── AWS S3 (raw/parsed document storage) ────────────────────────────────────
# OPTIONAL for local dev: the S3 upload calls in loaders/loader.py are
# currently commented out, so documents are only kept locally
# (documents/docling_output/) unless you re-enable those calls. Required for
# production document storage.
S3_BUCKET_NAME_PARSED_DOC=
S3_BUCKET_NAME_RAW_DOC=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=

# ── Embeddings ───────────────────────────────────────────────────────────────
# The OpenAI path is fully commented out in embedder/embedder.py — embedding
# actually happens via the same HF-hosted model as app/. This var is unused
# by the current code path; left here only because Settings() declares it.
OPENAI_API_KEY=

# ── Qdrant (must match app/'s QDRANT__URL / QDRANT__COLLECTION_NAME) ───────
QDRANT_URL=http://localhost:6333
COLLECTION_NAME=corpus

