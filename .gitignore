# ── Monorepo root .gitignore ──────────────────────────────────────────────────
# Each sub-project has its own .gitignore for project-specific rules.
# This file covers root-level artifacts only.

# Legacy frontend artifacts left at root after monorepo restructure.
# Safe to delete once VS Code is reopened with exobios-frontend/ as workspace root.
node_modules/
dist/
src/
.vite/

# Claude Code workspace files
.claude/

# IDE / editor
.vscode/
*.code-workspace
.idea/

# OS
.DS_Store
Thumbs.db
desktop.ini

# Environment files (never commit real secrets)
.env
.env.local
.env.*.local
