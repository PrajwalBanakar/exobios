# ── Exobios Backend — Environment Variables ───────────────────────────────────
# Copy this file to .env and fill in real values before running.
# Never commit .env to version control.

# ── Spring ────────────────────────────────────────────────────────────────────
SPRING_PROFILE=dev

# ── Server ────────────────────────────────────────────────────────────────────
SERVER_PORT=8080

# ── Database ──────────────────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=exobios
DB_USER=exobios
DB_PASSWORD=exobios
DB_POOL_SIZE=10

# ── JWT ───────────────────────────────────────────────────────────────────────
# Generate a secure key: openssl rand -base64 64
JWT_SECRET=CHANGE_THIS_TO_A_SECURE_256_BIT_SECRET_KEY_NEVER_COMMIT_THIS
JWT_ACCESS_EXPIRY=86400000
JWT_REFRESH_EXPIRY=604800000

# ── CORS ──────────────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:5173

# ── AI Integration (exobios-ai Python FastAPI) ────────────────────────────────
AI_SERVICE_URL=http://localhost:8000
AI_API_KEY=dev-key

# ── Storage ───────────────────────────────────────────────────────────────────
STORAGE_TYPE=local
STORAGE_LOCAL_PATH=./uploads
# Future S3 values (leave blank for local)
# STORAGE_S3_BUCKET=
# STORAGE_S3_REGION=ap-south-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
