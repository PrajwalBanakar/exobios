# Exobios AI Service — environment variable reference.
#
# This repo has TWO independently-run Python projects, each with its own uv
# environment and its own .env file (pydantic-settings reads ".env" relative
# to the process's working directory, so a single shared .env at this root
# would NOT be picked up by either):
#
#   app/.env         <- the FastAPI service (the one you run for Postman testing)
#   ingestion/.env    <- the standalone offline document-ingestion CLI tool
#
# Copy app/.env.example -> app/.env and ingestion/.env.example -> ingestion/.env
# and fill in real values there. This file just gives you the full picture in
# one place — see docs/LOCAL_SETUP.md for the exact commands.

# ============================================================================
# app/.env  (required to run the FastAPI service)
# ============================================================================
# AI_API_KEY=                    # shared secret for the X-Api-Key header (pick any value)
# QDRANT__URL=http://localhost:6333
# QDRANT__COLLECTION_NAME=corpus
# EMBEDDING__HF_TOKEN=           # Hugging Face access token (required)
# EMBEDDING__EMBED_MODEL=sentence-transformers/all-MiniLM-L6-v2
# EMBEDDING__VECTOR_SIZE=384
# RERANKER__HF_TOKEN=            # can reuse EMBEDDING__HF_TOKEN
# RERANKER__RERANK_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
# LLM__GROQ_API_KEY=             # Groq API key (required)
# LLM__MODEL=llama-3.3-70b-versatile
# MONGO__URI=mongodb://localhost:27017
# MONGO__DB_NAME=exobios
# MONGO__ASSESSMENTS_COLLECTION=assessments
# LANGSMITH__API_KEY=            # optional, leave blank to disable tracing
# LANGSMITH__PROJECT=exobios-ai

# ============================================================================
# ingestion/.env  (only needed if you run the document-ingestion CLI)
# ============================================================================
# ZEROSHOT_CLASSIFICATION_TOKEN_HF=   # Hugging Face token (required)
# SUPABASE_URL=                        # required — document metadata storage
# SUPABASE_KEY=
# S3_BUCKET_NAME_PARSED_DOC=           # optional locally (upload calls disabled)
# S3_BUCKET_NAME_RAW_DOC=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_DEFAULT_REGION=
# QDRANT_URL=http://localhost:6333     # must match app/'s QDRANT__URL
# COLLECTION_NAME=corpus               # must match app/'s QDRANT__COLLECTION_NAME
